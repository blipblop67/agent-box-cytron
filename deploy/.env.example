# Copy to backend/.env (the install script does this automatically) and fill
# in whatever you need, then restart the hub. Lines starting with # are
# ignored. Leave a variable out entirely to use its default (see the main
# README's configuration table).
#
# Google credentials don't belong here at all - set a service account key
# from the Settings page in the app instead (no restart needed, and no file
# to edit). There's no environment-variable fallback for this anymore.

# --- Embeddings for the knowledge base / RAG feature ---
# "local" runs a small model on the Pi itself (default, no setup needed).
# "ollama" delegates to an Ollama server elsewhere on your network.
# EMBEDDING_PROVIDER=local
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Where data lives ---
# AGENT_HUB_DATA_DIR=/home/pi/.agent-hub
