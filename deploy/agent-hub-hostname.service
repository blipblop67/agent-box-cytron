[Unit]
Description=Agent Hub - give this unit a unique hostname on first boot
After=systemd-machine-id-commit.service
Before=avahi-daemon.service
Wants=avahi-daemon.service
ConditionPathExists=!/etc/agent-hub-hostname-set

[Service]
Type=oneshot
ExecStart=__ROOT_DIR__/deploy/set-unique-hostname.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
